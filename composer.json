{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "novius/laravel-filament-page-manager",
    "description": "A Laravel Filament package to manage pages.",
    "keywords": [
        "laravel",
        "filament",
        "novius",
        "page-manager"
    ],
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Novius Agency",
            "email": "team-developpeurs@novius.com",
            "homepage": "https://www.novius.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "filament/filament": "^4.0 | ^5.0",
        "novius/laravel-filament-action-preview": "^1.0.0",
        "novius/laravel-filament-publishable": "^1.0.0",
        "novius/laravel-filament-slug": "^1.0.0",
        "novius/laravel-filament-translatable": "^1.0.0",
        "novius/laravel-json-casted": "^1.0.0",
        "novius/laravel-linkable": "^2.0.0",
        "novius/laravel-meta": "^1.2.0",
        "spatie/laravel-sluggable": "^3.4 | ^4.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.0 | ^3.0",
        "laravel/pint": "^1.7",
        "laravel/pao": "^1.0",
        "orchestra/testbench": "^9.0 | ^10.0 | ^11.0",
        "roave/security-advisories": "dev-latest",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Novius\\LaravelFilamentPageManager\\": "src/",
            "Novius\\LaravelFilamentPageManager\\Database\\Seeders\\": "database/seeders"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse --memory-limit 1G"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Novius\\LaravelFilamentPageManager\\LaravelFilamentPageManagerServiceProvider"
            ],
            "aliases": {
                "PageManager": "Novius\\LaravelFilamentPageManager\\Facades\\PageManager"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
